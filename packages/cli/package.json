{
  "name": "@nuxt/scripts-cli",
  "type": "module",
  "version": "1.3.2",
  "description": "Migration tools for Nuxt Scripts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt/scripts.git",
    "directory": "packages/cli"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    }
  },
  "main": "./dist/cli.mjs",
  "types": "./dist/cli.d.mts",
  "bin": {
    "nuxt-scripts": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "unbuild",
    "dev:prepare": "unbuild --stub",
    "test": "vitest run"
  },
  "dependencies": {
    "magicast": "catalog:",
    "pathe": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "unbuild": "catalog:",
    "vitest": "catalog:"
  }
}
